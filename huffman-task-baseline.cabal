cabal-version:      3.0
name:               huffman-task-baseline
version:            0.1.0.0
build-type:         Simple

executable huffman
  main-is:          Main.hs
  hs-source-dirs:   src
  default-language: Haskell2010
  build-depends:
      array
    , base >=4.21 && <4.23
    , bytestring
    , containers
  other-modules:
      Huffman.BitStream
      Huffman.Codec
      Huffman.Tree
