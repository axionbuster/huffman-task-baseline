cabal-version: 3.0
name:          huffman
version:       0.1.0.0
synopsis:      Huffman encoder/decoder
license:       MIT
build-type:    Simple

executable huffman
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:
    Huffman.Codec
    Huffman.Tree

  default-language: Haskell2010
  build-depends:
    array      >= 0.5 && < 0.6,
    base       >= 4.14 && < 5,
    bytestring >= 0.10 && < 0.13,
    containers >= 0.6 && < 0.8

  ghc-options: -O2
